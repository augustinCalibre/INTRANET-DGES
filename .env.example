SECRET_KEY=change-me-in-production
DEBUG=0
DJANGO_TIME_ZONE=Africa/Abidjan
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10,intranet-dges.local,messagerie.dges.local
POSTGRES_DB=intranet_dges
POSTGRES_USER=intranet_dges_user
POSTGRES_PASSWORD=change-me-too
DJANGO_SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
INTRANET_HOSTNAME=intranet-dges.local
INTRANET_URL=https://intranet-dges.local
INTRANET_FALLBACK_URL=https://192.168.1.10
MESSAGING_URL=https://messagerie.dges.local:8443
MESSAGING_FALLBACK_URL=https://192.168.1.10:8443
NEXTCLOUD_IMAGE=nextcloud:34-apache
# Attention : ces trois variables ne servent qu'à la CRÉATION de la base
# Nextcloud, au tout premier démarrage. Une fois Nextcloud installé, il lit ses
# identifiants dans son propre config.php, qui peut désigner un autre
# utilisateur. Changer ces valeurs après installation n'a aucun effet sur
# Nextcloud — et changer le mot de passe côté base sans mettre à jour
# config.php le met hors service.
NEXTCLOUD_POSTGRES_DB=nextcloud_dges
NEXTCLOUD_POSTGRES_USER=nextcloud_dges_user
NEXTCLOUD_POSTGRES_PASSWORD=change-me-nextcloud
NEXTCLOUD_ADMIN_USER=admin_dges
NEXTCLOUD_ADMIN_PASSWORD=change-me-nextcloud-admin
NEXTCLOUD_TRUSTED_DOMAINS=messagerie.dges.local intranet-dges.local 192.168.1.10
NEXTCLOUD_TRUSTED_PROXIES=nginx
NEXTCLOUD_OVERWRITEHOST=
NEXTCLOUD_OVERWRITEPROTOCOL=https
NEXTCLOUD_OVERWRITE_CLI_URL=https://messagerie.dges.local:8443
NEXTCLOUD_PHP_MEMORY_LIMIT=512M
NEXTCLOUD_PHP_UPLOAD_LIMIT=1024M
NEXTCLOUD_APACHE_BODY_LIMIT=1073741824
DOCUMENT_MAX_UPLOAD_SIZE=20971520
DOCUMENT_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,csv,txt,png,jpg,jpeg,odt,ods
DGES_DEMO_PASSWORD=
DGES_RESET_DEMO_PASSWORDS=0
