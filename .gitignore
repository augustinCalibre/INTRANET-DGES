# Certificats et clés privées.
# Le motif couvre tout le dossier : les anciens motifs *.crt et *.key
# laissaient passer les copies de sauvegarde .bak, donc la clé privée.
docker/nginx/certs/*
!docker/nginx/certs/openssl-dges-local.cnf

# Éditeurs
.idea/
.vscode/settings.json
